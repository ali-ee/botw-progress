# Game-derived data (map data, icons, maps, quest text) is downloaded or built locally, never committed
assets/
# Saves never belong in the repo
*.sav
# Local settings and logs
config.json
# Korok hints you collect yourself (a guide's text: yours to keep, not the repository's)
korok_hints.json
# An online map's marker exports you saved yourself (Korok types, dragons, quest givers): yours, not the repository's
markers.json
markers-ext.json
app.log
__pycache__/
*.part
.claude/
# Build output
build/
dist/
*.spec
webview/
.venv/
